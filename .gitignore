static/uploads/

# Training dataset — large, shouldn't live in a deploy repo
dataset/

# Hugging Face / model cache (local dev only)
.cache/
huggingface_cache/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
saved_model_tmp/
